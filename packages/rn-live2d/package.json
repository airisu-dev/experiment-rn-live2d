{
  "name": "rn-live2d",
  "version": "0.1.0",
  "description": "react-native-rn-live2d is a react native package built with Nitro",
  "main": "src/index",
  "types": "src/index",
  "react-native": "src/index",
  "source": "src/index",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "git clean -dfX",
    "build": "bun run typecheck && bob build",
    "codegen": "nitrogen --logLevel=debug"
  },
  "keywords": [
    "react-native",
    "react-native-rn-live2d"
  ],
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "cpp",
    "nitro.json",
    "android/build.gradle",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "app.plugin.js",
    "*.podspec",
    "README.md"
  ],
  "repository": "https://github.com/airisu.dev/react-native-rn-live2d.git",
  "author": "airisu.dev",
  "license": "MIT",
  "bugs": "https://github.com/airisu.dev/react-native-rn-live2d/issues",
  "homepage": "https://github.com/airisu.dev/react-native-rn-live2d#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "nitrogen": "^0.37.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.40.18",
    "react-native-nitro-modules": "^0.37.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "expo-asset": "*",
    "expo-file-system": "*",
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*",
    "react-native-reanimated": "*",
    "react-native-skia": "*",
    "react-native-worklets": "*"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "plugins": [
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "warn",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
